+    void place_fixed_children(CellInfo *cell)
+    {
+        NPNR_ASSERT(cell->bel != BelId());
+        Loc base = ctx->getBelLocation(cell->bel);
+        for (auto child : cell->constr_children) {
+            Loc cloc = base;
+            if (child->constr_x != child->UNCONSTR)
+                cloc.x += child->constr_x;
+            if (child->constr_y != child->UNCONSTR)
+                cloc.y += child->constr_y;
+            if (child->constr_z != child->UNCONSTR)
+                cloc.z = child->constr_abs_z ? child->constr_z : (base.z + child->constr_z);
+
+            BelId target = ctx->getBelByLocation(cloc);
+            if (target == BelId())
+                log_error("No Bel found for fixed child cell '%s' at constrained location (%d, %d, %d)\n",
+                          child->name.c_str(ctx), cloc.x, cloc.y, cloc.z);
+            if (ctx->getBelType(target) != child->type)
+                log_error("Bel '%s' of type '%s' does not match fixed child cell '%s' of type '%s'\n",
+                          ctx->getBelName(target).c_str(ctx), ctx->getBelType(target).c_str(ctx),
+                          child->name.c_str(ctx), child->type.c_str(ctx));
+            if (!ctx->isValidBelForCell(child, target))
+                log_error("Bel '%s' is not valid for fixed child cell '%s'\n",
+                          ctx->getBelName(target).c_str(ctx), child->name.c_str(ctx));
+
+            if (child->bel != BelId()) {
+                if (child->bel != target)
+                    log_error("Fixed child cell '%s' is already bound to '%s', expected constrained Bel '%s'\n",
+                              child->name.c_str(ctx), ctx->getBelName(child->bel).c_str(ctx),
+                              ctx->getBelName(target).c_str(ctx));
+            } else {
+                CellInfo *bound = ctx->getBoundBelCell(target);
+                if (bound != nullptr)
+                    log_error("Fixed child cell '%s' cannot be bound to Bel '%s' since it is already bound to cell '%s'\n",
+                              child->name.c_str(ctx), ctx->getBelName(target).c_str(ctx), bound->name.c_str(ctx));
+                ctx->bindBel(target, child, STRENGTH_STRONG);
+            }
+            place_fixed_children(child);
+        }
+    }
+
